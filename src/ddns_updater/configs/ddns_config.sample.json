{
  "targets": [
    {
      "provider": "cloudflare",
      "domain": "example.com",
      "timeout": 10,
      "tasks": [
        {
          "name": "www",
          "type": "AAAA",
          "source": "local.eno4"
        },
        {
          "name": "@",
          "type": "A",
          "source": "local.enp1s0"
        }
      ]
    },
    {
      "provider": "cloudflare",
      "domain": "example.com",
      "timeout": 10,
      "unifi_credentials": {
        "controller_url": "https://192.168.0.1",
        "username": "your_unifi_username",
        "password": "your_unifi_password"
      },
      "tasks": [
        {
          "name": "gateway",
          "type": "AAAA",
          "source": "unifi"
        }
      ]
    }
  ]
}
